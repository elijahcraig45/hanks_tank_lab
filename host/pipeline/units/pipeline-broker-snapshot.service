[Unit]
Description=Pipeline broker: publish status for the mllab app
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/pipeline/current/RELEASE.json

[Service]
Type=oneshot
User=pipeline
Group=pipeline
Slice=pipeline.slice
EnvironmentFile=/etc/pipeline/env
Environment=PYTHONPATH=/opt/pipeline/lib
Environment=PIPELINE_RELEASE=/opt/pipeline/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
WorkingDirectory=/var/lib/pipeline/work
ExecStart=/opt/pipeline/venv/bin/python -m mllab.pipeline.broker snapshot
MemoryMax=256M
TimeoutStartSec=2min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/pipeline /mnt/appdata/mllab/pipeline-status
SyslogIdentifier=pipeline-broker-snapshot
